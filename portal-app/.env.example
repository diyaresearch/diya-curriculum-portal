# Frontend Environment Configuration
# Copy this file to .env.development (for local dev) or .env.production (for production)
# and fill in your actual values

# API Configuration
# One backend serves the whole API (#439): the Cloud Function in functions/.
# Locally that is `npm start` in functions/ on port 3001, which Vite also
# proxies /api to. In production this is the deployed function's URL:
#   https://us-central1-<project>.cloudfunctions.net/payments
# Leave it blank to call the API same-origin and rely on the Firebase Hosting
# rewrite of /api/** (firebase.json) instead.
VITE_SERVER_ORIGIN_URL=http://localhost:3001
VITE_HOME_PAGE=http://localhost:3000
VITE_DIYA_BASE_URL=https://diya-research.org

# Firebase Configuration
# Get these values from your Firebase project settings (Project Settings ->
# Your apps). All six below are required — src/firebase/firebaseConfig.js
# refuses to start and names the missing ones rather than letting the app load
# and fail later with auth/invalid-api-key. MEASUREMENT_ID is analytics-only
# and optional. These are public identifiers, not secrets; they ship in the
# bundle. The Admin SDK's credential is a different thing entirely and never
# appears here (see functions/CREDENTIALS.md).
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Points this app at the local Firebase emulator suite instead of the real
# project above (#428). Off by default, and you should not need to set it by
# hand: `./start.sh --emulator` exports it (and pins the project ID) for both
# the frontend and the backend at once. Never set it in
# .env.development/.env.production.
VITE_USE_FIREBASE_EMULATOR=false

# Staging (#428): create a gitignored .env.staging next to this file with the
# curriculum-portal-staging web app config (Firebase Console → Project Settings
# → curriculum-portal-staging → Your apps), then run `./start.sh --staging`
# from the repo root. See the README's "Staging project" section.
#
# .env.staging must be SELF-CONTAINED. `vite --mode staging` loads .env and
# then .env.staging — it does not load .env.development — so copy
# VITE_SERVER_ORIGIN_URL, VITE_HOME_PAGE, VITE_DIYA_BASE_URL and
# VITE_STRIPE_PUBLISHABLE_KEY into it alongside the six VITE_FIREBASE_* keys.
#
# Do NOT point the frontend at staging with a .env.development.local override
# instead. That moves only the browser: the backend takes its project from
# functions/.env.${NODE_ENV}, never from this directory, so it stays on
# production and every authenticated call fails with a 401 from verifyIdToken
# (a token minted by one project cannot be verified against another). ./start.sh
# refuses to start in that state, and src/utils/verifyBackendProject.ts reports
# it in the browser console if it happens some other way.

# Stripe Configuration
# Replace with your actual Stripe publishable key from dashboard (starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here