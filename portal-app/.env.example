# Frontend Environment Configuration
# Copy this file to .env.development (for local dev) or .env.production (for production)
# and fill in your actual values

# Server Configuration
REACT_APP_SERVER_ORIGIN_URL=http://localhost:3001
REACT_APP_HOME_PAGE=http://localhost:3000
REACT_APP_DIYA_BASE_URL=https://diya-research.org

# Firebase Configuration
# Get these values from your Firebase project settings
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Set to "true" in a gitignored .env.development.local to point this app at
# the local Firebase emulator suite instead of the real project above (#428).
# Off by default — never set this in .env.development/.env.production.
REACT_APP_USE_FIREBASE_EMULATOR=false

# Staging (#428): to point npm start at curriculum-portal-staging instead of
# production, override the six REACT_APP_FIREBASE_* keys above in a gitignored
# .env.development.local with that project's web app config (Firebase Console
# → Project Settings → curriculum-portal-staging → Your apps). See the
# README's "Staging project" section.

# Stripe Configuration
# Replace with your actual Stripe publishable key from dashboard (starts with pk_test_ or pk_live_)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here