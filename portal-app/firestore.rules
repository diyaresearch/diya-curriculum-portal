rules_version = '2';

// Firestore security rules for the DIYA Curriculum Portal.
//
// Design notes (issues #419, #420, #382, #428):
//
// * The client SDK reads content collections directly — the landing page and
//   module list do not go through the API — so those stay publicly readable.
// * Everything involving identity, money, or role is server-only. The Express
//   API and Cloud Functions use the Admin SDK, which bypasses these rules
//   entirely, so denying the client costs the server nothing.
// * Firestore evaluates rules as a union: if any match allows, access is
//   granted. A collection with no matching rule is denied by default.
// * There is one identity collection, `users`. It used to be split into
//   `teachers`/`students`, with a `DATABASE_SCHEMA_QUALIFIER` prefix on top
//   layering dev/prod into the same project (#427). Both were retired in
//   #428: dev/staging and production are now separate Firebase projects, and
//   every account — admin, teacherPlus, teacherDefault, studentDefault —
//   lives in `users` with a `role` field.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Fields a client must never set or change. Roles and subscription state
    // are assigned server-side after payment verification; Stripe identifiers
    // are written only by the payment handlers.
    function privilegedFields() {
      return [
        'role',
        'subscriptionType',
        'subscriptionStatus',
        'subscriptionEndDate',
        'stripeCustomerId',
        'stripePaymentIntentId'
      ];
    }

    // An update must not touch any privileged field.
    function noPrivilegedChange() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(privilegedFields());
    }

    // Is the caller an admin? Custom claim first: it rides in the ID token and costs nothing to read
    // (#382). Absent or stale claims fall through to the profile document, so
    // the claim can only grant access sooner, never withhold it.
    function hasAdminClaim() {
      return isSignedIn() && request.auth.token.get('role', '') == 'admin';
    }

    function isAdmin() {
      return hasAdminClaim() || (isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Fields that decide what a buyer is charged. The checkout session reads
    // `price` straight out of the module document, so a client that can write
    // it can set its own price (#429).
    function pricingFields() {
      return ['price', 'Price', 'isFeatured'];
    }

    function pricingUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(pricingFields());
    }

    function noPricingOnCreate() {
      return !request.resource.data.keys().hasAny(pricingFields())
             || (request.resource.data.get('price', 0) == 0
                 && request.resource.data.get('Price', 0) == 0
                 && request.resource.data.get('isFeatured', false) == false);
    }

    // Self-signup writes its own profile with a fixed default role
    // (portal-app/src/pages/sign_up/index.jsx writes 'teacherDefault' or
    // 'studentDefault'). Permit exactly those roles and nothing else
    // privileged, so a user cannot register as an admin or teacherPlus.
    function safeSelfCreate() {
      return !request.resource.data.keys().hasAny([
               'subscriptionType',
               'subscriptionStatus',
               'subscriptionEndDate',
               'stripeCustomerId',
               'stripePaymentIntentId'
             ])
             && (!request.resource.data.keys().hasAny(['role'])
                 || request.resource.data.role in ['teacherDefault', 'studentDefault']);
    }

    // --------------------------------------------------------- user profiles

    // Self-signup writes its own document directly (#428); the API owns
    // everything else (updateRole, admin listing — the Admin SDK bypasses
    // rules for those). Owner-only was already enforced for the old
    // teachers/students collections; what was missing was stopping an owner
    // from promoting themselves by rewriting their own role.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && safeSelfCreate();
      allow update: if isOwner(userId) && noPrivilegedChange();
      allow delete: if false;
    }

    // ------------------------------------------------------- public content
    //
    // Unchanged for now: publicly readable, writable by any signed-in user.
    // Tightening writes to the document author is tracked in #429, which needs
    // a data audit first — ownership is recorded inconsistently across these
    // collections (`author` on module/lesson, `User` on content, with some
    // documents using `authorId`), and legacy documents may carry none of them.

    match /content/{contentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /module/{moduleId} {
      allow read: if true;
      // Anyone signed in may still author modules, but only an admin may set
      // or change what a module costs (#429).
      allow create: if isSignedIn() && (isAdmin() || noPricingOnCreate());
      allow update: if isSignedIn() && (isAdmin() || pricingUnchanged());
      allow delete: if isSignedIn();
    }

    match /lesson/{lessonId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --------------------------------------------------------- testimonials
    //
    // Read by TestimonialsSection.jsx. Previously no rule matched, so the read
    // was denied and the component silently fell back to fabricated content
    // (#433). Public to read, never client-writable.

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------- entitlements (#430)
    //
    // Proof that a module was paid for. Written only by the Stripe webhook
    // through the Admin SDK, so the client can read its own entitlements but
    // can never mint one. Document id is `{uid}_{moduleId}`, which makes the
    // webhook write idempotent by construction.

    match /entitlements/{entitlementId} {
      allow read: if isSignedIn()
                  && entitlementId.split('_')[0] == request.auth.uid;
      allow write: if false;
    }

    // ------------------------------------------- server-only collections (#382)
    //
    // Money, contact records, and counters. These are reached only through the
    // Admin SDK. They were already denied by default; stating them explicitly
    // means a future `match /{document=**}` cannot silently open them, and it
    // documents that the omission is deliberate.

    match /payment_logs/{logId}        { allow read, write: if false; }
    match /subscriptions/{subId}       { allow read, write: if false; }
    match /enterprise_contacts/{docId} { allow read, write: if false; }
    match /counters/{counterId}        { allow read, write: if false; }
  }
}
