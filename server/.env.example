# Backend Environment Configuration
# Copy this file to .env.development (for local dev) or .env.production (for production)
# and fill in your actual values

# Server Configuration
NODE_ENV=development
SERVER_ALLOW_ORIGIN=http://localhost:3000
PORT=3001

# Database Configuration
# Used for schema prefixing in multi-environment setups
# Collection-name prefix. MUST match portal-app for the same environment (#427):
#   production  prod.
#   development (empty)
# The server refuses to start in production if this is unset.
DATABASE_SCHEMA_QUALIFIER=

# Stripe Configuration
# Replace with your actual Stripe secret key from dashboard (starts with sk_test_ or sk_live_)
# NEVER commit this key to version control!
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Firebase Mock Configuration (for development/testing)
# Set to true to use mock Firebase services instead of real Firebase
ENABLE_MOCK_FIREBASE=false

# Firebase Service Account
# Place your serviceAccountKey.json file in the server/ directory
# This file should contain your Firebase Admin SDK credentials
# NEVER commit this file to version control!

# Additional Environment Variables
# Add any other environment-specific configurations here

# Firebase Admin credentials
# Preferred: no variables at all. Run `gcloud auth application-default login`
# locally; on App Engine the runtime service account is used automatically.
# See CREDENTIALS.md for the full resolution order.
FIREBASE_PROJECT_ID=curriculum-portal-1ce8f
# FIREBASE_SERVICE_ACCOUNT=          # CI only: service account JSON, or its base64
# FIREBASE_ALLOW_KEY_FILE=false      # opt in to a local serviceAccountKey.json (discouraged)
